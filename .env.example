# You normally don't edit this by hand:
#   python tools/deploy_contract.py --rpc https://rpc-amoy.polygon.technology --key 0xTESTNET_KEY
# deploys the contract and writes .env for you. Use a TESTNET-ONLY wallet.
CHAIN_MODE=web3
RPC_URL=https://rpc-amoy.polygon.technology
PRIVATE_KEY=0xYOUR_TESTNET_WALLET_PRIVATE_KEY
CONTRACT_ADDRESS=0xYOUR_DEPLOYED_LogAnchor_ADDRESS
